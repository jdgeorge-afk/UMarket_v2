# Supabase project URL (same as your frontend VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — Supabase Dashboard → Settings → API → service_role key
# NEVER commit this key. It bypasses all RLS policies.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# UUID of the bot Supabase user to post scraped listings under.
# Create one in: Supabase Dashboard → Authentication → Users → Add user
# Give it an email like listings-bot@umarket.com
BOT_USER_ID=00000000-0000-0000-0000-000000000000

# Default school for imported listings (overridable with --school=xxx flag)
DEFAULT_SCHOOL_ID=utah
