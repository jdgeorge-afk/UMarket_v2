# Copy this file to .env and fill in your values
# Do NOT commit your .env file to GitHub

# Google Places API key (get from Rian — shared team key)
GOOGLE_PLACES_API_KEY=your_api_key_here

# Your own email address — Gmail drafts will be created here
GMAIL_USER=your.email@gmail.com

# Leave this as-is
GOOGLE_SHEETS_CREDS_FILE=gmail_oauth_credentials.json
